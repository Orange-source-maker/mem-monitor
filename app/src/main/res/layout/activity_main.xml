<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部：标题 + 开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_start" />
        </LinearLayout>

        <!-- 整机内存卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tv_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textColor="@color/accent"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_low_mem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/low_mem_warning"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout style="@style/StatCol">
                    <TextView style="@style/StatLabel" android:text="@string/label_used" />
                    <TextView android:id="@+id/tv_used" style="@style/StatValue" android:text="--" />
                </LinearLayout>

                <LinearLayout style="@style/StatCol">
                    <TextView style="@style/StatLabel" android:text="@string/label_avail" />
                    <TextView android:id="@+id/tv_avail" style="@style/StatValue" android:text="--" />
                </LinearLayout>

                <LinearLayout style="@style/StatCol">
                    <TextView style="@style/StatLabel" android:text="@string/label_total" />
                    <TextView android:id="@+id/tv_total" style="@style/StatValue" android:text="--" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_swap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/swap_none"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <com.memmonitor.ui.MemoryChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- 各应用排行卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rank_title"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_shizuku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/btn_authorize" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_rank_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_rank_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/rank_waiting"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_ranking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 设置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="@string/setting_sample_interval" />
                <Spinner android:id="@+id/sp_sample_interval" style="@style/SettingSpinner" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="@string/setting_rank_interval" />
                <Spinner android:id="@+id/sp_rank_interval" style="@style/SettingSpinner" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="@string/setting_floating" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_floating" style="@style/SettingSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="@string/setting_boot" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_boot" style="@style/SettingSwitch" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
